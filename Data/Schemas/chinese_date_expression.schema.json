{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chinese-calendar.local/schemas/chinese_date_expression.schema.json",
  "title": "ChineseDateExpressionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "precision",
    "index",
    "uncertainRange",
    "sourceText",
    "note"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "历史日期表达的稳定标识符。其他记录通过这个 ID 引用该日期表达。"
    },
    "precision": {
      "type": "string",
      "enum": [
        "year",
        "month",
        "day",
        "range",
        "unknown"
      ],
      "description": "日期表达的精度：year、month、day、range 或 unknown。它决定 index 和 uncertainRange 的解释方式。",
      "x-codegen": {
        "swiftType": "ChineseDatePrecision",
        "tsType": "ChineseDatePrecision"
      }
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "description": "在指定精度下的稳定日期索引。precision 为 range 或 unknown 时通常为 null。"
    },
    "uncertainRange": {
      "description": "不确定日期或范围日期的可选上下界。",
      "anyOf": [
        {
          "$ref": "#/$defs/chineseDateRange"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceText": {
      "type": "string",
      "description": "从上游朝代或时期来源中保留下来的可读原文。"
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "description": "导入器对来源解释、边界或不确定性的可选说明。"
    }
  },
  "$defs": {
    "chineseDateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lowerBound",
        "upperBound"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "不确定日期范围的稳定标识符。"
        },
        "lowerBound": {
          "description": "不确定日期范围的下界。",
          "$ref": "#/$defs/chineseDateBound"
        },
        "upperBound": {
          "description": "不确定日期范围的上界；具体是否按开区间解释取决于日期精度和调用场景。",
          "$ref": "#/$defs/chineseDateBound"
        }
      },
      "x-codegen": {
        "typeName": "ChineseDateRangeRecord"
      }
    },
    "chineseDateBound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "precision",
        "index"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "日期范围边界的稳定标识符。"
        },
        "precision": {
          "type": "string",
          "enum": [
            "year",
            "month",
            "day",
            "range",
            "unknown"
          ],
          "description": "这个日期范围边界的精度。",
          "x-codegen": {
            "swiftType": "ChineseDatePrecision",
            "tsType": "ChineseDatePrecision"
          }
        },
        "index": {
          "type": "integer",
          "description": "这个日期范围边界在指定精度下的稳定日期索引。"
        }
      },
      "x-codegen": {
        "typeName": "ChineseDateBoundRecord"
      }
    }
  },
  "x-codegen": {
    "record": true,
    "typeName": "ChineseDateExpressionRecord",
    "dataFile": "chinese_date_expressions.jsonl"
  }
}
