{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chinese-calendar.local/schemas/calendar_day_bundle.schema.json",
  "title": "CalendarDayBundleRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "calendarDay",
    "civilDate",
    "chineseLunarDay"
  ],
  "properties": {
    "calendarDay": {
      "$ref": "#/$defs/calendarDay"
    },
    "civilDate": {
      "$ref": "#/$defs/civilDate"
    },
    "chineseLunarDay": {
      "$ref": "#/$defs/chineseLunarDay"
    }
  },
  "$defs": {
    "calendarDay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dayIndex",
        "julianDayNumber"
      ],
      "properties": {
        "dayIndex": {
          "type": "integer"
        },
        "julianDayNumber": {
          "type": "integer",
          "minimum": 0
        }
      },
      "x-codegen": {
        "typeName": "CalendarDayRecord"
      }
    },
    "civilDate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dayIndex",
        "year",
        "month",
        "dayOfMonth",
        "calendarStyle"
      ],
      "properties": {
        "dayIndex": {
          "type": "integer"
        },
        "year": {
          "type": "integer"
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "dayOfMonth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "calendarStyle": {
          "type": "string",
          "enum": [
            "julian",
            "gregorian"
          ],
          "x-codegen": {
            "swiftType": "CivilCalendarStyle",
            "tsType": "CivilCalendarStyle"
          }
        }
      },
      "x-codegen": {
        "typeName": "CivilDateRecord"
      }
    },
    "chineseLunarDay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dayIndex",
        "lunarMonthIndex",
        "dayNumberInMonth",
        "dayStemIndex",
        "dayBranchIndex"
      ],
      "properties": {
        "dayIndex": {
          "type": "integer"
        },
        "lunarMonthIndex": {
          "type": "integer"
        },
        "dayNumberInMonth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "dayStemIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "dayBranchIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        }
      },
      "x-codegen": {
        "typeName": "LunarDayRecord"
      }
    }
  },
  "x-codegen": {
    "record": true,
    "typeName": "CalendarDayBundleRecord",
    "dataGlob": "calendar_days/*/calendar_days.jsonl"
  }
}
